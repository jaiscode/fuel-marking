# Copy to .env and edit. Never commit .env.
POSTGRES_USER=fuelmarking
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Your OpenID Connect provider (see docs/oidc-setup.md for Keycloak / Entra ID / Okta / Auth0)
OIDC_ISSUER_URI=https://idp.example.com/realms/fuelmarking
OIDC_AUDIENCE=
OIDC_CLIENT_ID=fuelmarking-web
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_ROLE=fuelmarking-admin
OIDC_VIEWER_ROLE=fuelmarking-viewer

# Hostname marking sites use to reach Kafka (must resolve from the sites)
KAFKA_PUBLIC_HOST=localhost
